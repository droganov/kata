xt", "name": "Сгибание-разгибание в лучезапястных суставах", "dose": "15", "images": [], "instructions": ""}], "zone": "Плечевой пояс", "joint": "wrist", "unit": "контур"}, {"id": "W_fingers", "kind": "pool", "label": "Плечевой пояс · пальцы", "items": [{"id": "fist_open_close", "name": "Сжимание-разжимание пальцев в кулак", "dose": "15", "images": [], "instructions": ""}], "zone": "Плечевой пояс", "joint": "fingers", "unit": "контур"}, {"id": "W_t_spine", "kind": "pool", "label": "Грудь, спина · грудной отдел", "items": [{"id": "torso_twist", "name": "Повороты корпуса стоя", "dose": "по 10 в каждую сторону", "images": [], "instructions": ""}], "zone": "Грудь, спина", "joint": "t_spine", "unit": "контур"}, {"id": "W_lumbopelvic", "kind": "pool", "label": "Поясница · пояснично-тазовый", "items": [{"id": "hip_circles", "name": "Круги тазом стоя", "dose": "по 10 в каждую сторону", "images": [], "instructions": ""}], "zone": "Поясница", "joint": "lumbopelvic", "unit": "контур"}, {"id": "W_hip", "kind": "pool", "label": "Бёдра · тазобедренный сустав", "items": [{"id": "leg_swing_fb", "name": "Махи ногой вперёд-назад", "dose": "10/сторона", "images": [], "instructions": ""}], "zone": "Бёдра", "joint": "hip", "unit": "контур"}, {"id": "W_knee_j", "kind": "pool", "label": "Колени · коленный сустав", "items": [{"id": "knee_circles", "name": "Круги коленями", "dose": "по 10 в каждую сторону", "images": [], "instructions": ""}], "zone": "Колени", "joint": "knee_j", "unit": "контур"}, {"id": "W_ankle", "kind": "pool", "label": "Стопы · голеностоп и стопа", "items": [{"id": "ankle_circles", "name": "Круги стопой", "dose": "по 10 в каждую сторону, каждая нога", "images": [], "instructions": ""}], "zone": "Стопы", "joint": "ankle", "unit": "контур"}]}, {"id": "strength", "title": "Силовой", "slots": [{"id": "BASE", "kind": "base", "label": "БАЗА", "items": [{"id": "glute_bridge_m", "name": "Ягодичный мост в тренажёре", "dose": "3×12–15", "images": [], "instructions": "Заменяет румынскую тягу: даёт ту же заднюю цепь, но без наклона под весом. Лопатки лежат на скамье, стопы под коленями. Подъём заканчивается там, где плечи, таз и колени встают в одну линию — выше не надо, дальше идёт переразгибание поясницы. Подбородок слегка к груди, взгляд вперёд, а не в потолок: это удерживает таз от заваливания."}, {"id": "hip_abd_cable", "name": "Отведение бедра в блоке стоя", "dose": "3×12–15/сторона", "images": [], "instructions": ""}]}, {"id": "K", "kind": "pool", "label": "Колено", "items": [{"id": "leg_press", "name": "Жим ногами сидя горизонтально", "dose": "3×12–15", "images": [], "instructions": "стопы выше середины платформы, не опускать до отрыва таза\n\nСтопы поставить выше середины платформы: чем выше стопа, тем меньше требуется сгибания в тазобедренном суставе внизу. Опускать только до момента, пока таз прижат к сиденью. Как только копчик пошёл вверх и поясница начала округляться — это нагруженное сгибание, ровно тот механизм, которого нужно избегать. Лучше короткая амплитуда, чем сорванный таз. Колени не сводить внутрь, внизу не отбивать вес."}]}, {"id": "Z", "kind": "pool", "label": "Задняя цепь", "items": [{"id": "leg_curl_seated", "name": "Сгибание голени сидя", "dose": "3×12–15", "images": [], "instructions": "Берите сидячий вариант. В версии лёжа на животе при усилии поясница переразгибается, и в вашем случае это лишний риск. Валик лежит над коленом и держит бедро на месте; таз не отрывать от сиденья."}]}, {"id": "J", "kind": "pool", "label": "Жим", "items": [{"id": "chest_press_m", "name": "Жим в тренажёре на грудь", "dose": "3×12–15", "images": [], "instructions": "Отрегулируйте сиденье так, чтобы рукояти были на уровне середины груди. Плечи прижаты к спинке и не выезжают вперёд в конце движения — это частая ошибка, которая нагружает переднюю часть плеча. Локти не выпрямлять полностью."}]}, {"id": "T", "kind": "pool", "label": "Тяга", "items": [{"id": "lat_pd_wide", "name": "Тяга верхнего блока широким хватом", "dose": "3×12–15", "images": [], "instructions": "Отрегулируйте валик так, чтобы бёдра были плотно прижаты — иначе вас будет тянуть вверх. Корпус отклонён назад градусов на 15 и держится неподвижно: раскачивание корпусом — это как раз работа поясницей. Тянуть до верха груди, не за голову."}]}, {"id": "D", "kind": "pool", "label": "Добор: плечо и икры", "items": [{"id": "rear_delt_m", "name": "Задние дельты в тренажёре", "dose": "2×15–20", "images": [], "instructions": ""}]}]}, {"id": "static", "title": "Калистеника", "slots": [{"id": "BASE", "kind": "base", "label": "БАЗА", "items": [{"id": "curlup", "name": "Скручивание Макгилла", "dose": "3×10с", "images": [], "instructions": "Лёжа на спине, руки под поясницей для поддержки, одна нога согнута, вторая прямая. Приподнимаешь плечи и голову совсем немного — подъём 2–3 см, ровно чтобы включились мышцы. Ладони сохраняют прогиб поясницы. Удержание 10 секунд."}, {"id": "bridge_hold", "name": "Удержание ягодичного моста", "dose": "3×20с", "images": [], "instructions": ""}]}, {"id": "S", "kind": "pool", "label": "Статика, добор", "items": [{"id": "side_plank", "name": "Боковая планка", "dose": "10с × 5/сторона", "images": [], "instructions": "Локоть строго под плечом. Плечо — таз — колено на одной линии. Удержание 10 секунд. Начинать можно с согнутых коленей."}, {"id": "pallof", "name": "Жим Паллоффа в блочной стойке", "dose": "10с × 8/сторона", "images": [], "instructions": ""}]}]}, {"id": "stretch", "title": "Растяжка", "slots": [{"id": "BASE", "kind": "base", "label": "БАЗА", "items": [{"id": "st_hipflex", "name": "Сгибатели бедра в выпаде", "dose": "40с × 2", "images": [], "instructions": "статика 40с × 2 или PNF (5с напряжения → 20с расслабления × 2) — по выбору, эффект сопоставим"}, {"id": "st_fig4", "name": "Фигура 4 сидя на скамье", "dose": "40с × 2", "images": [], "instructions": "статика 40с × 2 или PNF (5с напряжения → 20с расслабления × 2) — по выбору, эффект сопоставим"}]}, {"id": "GH", "kind": "pool", "label": "Растяжка бедра — все направления", "items": [{"id": "st_ham_strap", "name": "Задняя поверхность бедра лёжа с ремнём", "dose": "40с × 2/сторона", "images": [], "instructions": "таз на полу, поясница нейтральна — никаких наклонов стоя"}]}, {"id": "G", "kind": "pool", "label": "Растяжка под нагрузку дня", "items": [{"id": "st_pec_door", "name": "Грудные в дверном проёме", "dose": "40с × 2", "images": [], "instructions": ""}]}]}]}
