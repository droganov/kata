{
	"extends": ["html-validate:recommended", "html-validate:a11y"],
	"rules": {
		"no-inline-style": "off",
		"require-sri": "off",
		"doctype-style": [
			"error",
			{
				"style": "lowercase"
			}
		],
		"void-style": [
			"error",
			{
				"style": "selfclose"
			}
		]
	},
	"elements": ["html5"]
}
