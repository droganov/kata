root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{ts,js,mjs,cjs,svelte,json,jsonc,css,html,svg}]
indent_style = tab

[{Makefile,makefile,*.mk}]
indent_style = tab

[*.py]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{jsonl,txt}]
insert_final_newline = true
