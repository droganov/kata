{
	"name": "app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "eslint --max-warnings 0 .",
		"lint:css": "stylelint \"src/**/*.{css,svelte}\"",
		"lint:html": "html-validate src/app.html",
		"lint:fmt": "prettier --check .",
		"lint:dead": "knip",
		"format": "prettier --write . && eslint --fix .",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@deno/svelte-adapter": "^0.2.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^22",
		"@vitest/coverage-v8": "^5.0.0",
		"@vitest/eslint-plugin": "^1.6.27",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"daisyui": "^5.7.28",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-boundaries": "^7.2.0",
		"eslint-plugin-check-file": "^3.3.2",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-perfectionist": "^5.11.0",
		"eslint-plugin-prefer-arrow-functions": "^3.10.2",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-regexp": "^3.3.0",
		"eslint-plugin-sonarjs": "^4.2.0",
		"eslint-plugin-svelte": "^3.19.0",
		"eslint-plugin-unicorn": "^74.0.0",
		"globals": "^17.6.0",
		"happy-dom": "^20.14.3",
		"html-validate": "^11.15.0",
		"knip": "^6.35.1",
		"postcss-html": "^2.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"stylelint": "^17.15.0",
		"stylelint-config-html": "^2.0.0",
		"stylelint-config-standard": "^40.0.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">=22.18"
	}
}
