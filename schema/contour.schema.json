{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "contour.schema.json",
	"title": "Contour",
	"description": "Контур зоны (сгибатели шеи, верхняя трапеция…). Упражнения вложены.",
	"type": "object",
	"additionalProperties": false,
	"required": ["id", "slug", "title", "exercises"],
	"properties": {
		"id": {
			"$ref": "common.schema.json#/definitions/uuid"
		},
		"slug": {
			"$ref": "common.schema.json#/definitions/slug"
		},
		"title": {
			"$ref": "common.schema.json#/definitions/text"
		},
		"pick": {
			"type": "integer",
			"minimum": 1,
			"description": "Сколько упражнений контура берётся в занятие по умолчанию"
		},
		"exercises": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "exercise.schema.json"
			}
		}
	}
}
