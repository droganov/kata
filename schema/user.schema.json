{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "user.schema.json",
	"title": "User",
	"description": "Пользователь. Пока один.",
	"type": "object",
	"additionalProperties": false,
	"required": ["id", "name", "programs"],
	"properties": {
		"id": {
			"$ref": "common.schema.json#/definitions/uuid"
		},
		"name": {
			"$ref": "common.schema.json#/definitions/text"
		},
		"programs": {
			"$ref": "common.schema.json#/definitions/ref_list",
			"description": "Программы пользователя (Program.id)"
		}
	}
}
