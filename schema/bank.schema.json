{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bank.schema.json",
  "title": "Bank",
  "description": "Банк упражнений раздела: зоны → контуры → упражнения. Четыре банка: warmup, strength, calisthenics, stretch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "title",
    "rules",
    "zones"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/definitions/uuid"
    },
    "slug": {
      "type": "string",
      "enum": [
        "warmup",
        "strength",
        "calisthenics",
        "stretch"
      ]
    },
    "title": {
      "$ref": "common.schema.json#/definitions/text"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/definitions/text"
      }
    },
    "session_budget_sec": {
      "type": "integer",
      "minimum": 1
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "reason"
        ],
        "properties": {
          "name": {
            "$ref": "common.schema.json#/definitions/text"
          },
          "reason": {
            "$ref": "common.schema.json#/definitions/text"
          }
        }
      }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "zone.schema.json"
      }
    }
  }
}
