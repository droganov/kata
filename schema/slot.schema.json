{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "slot.schema.json",
	"title": "Slot",
	"description": "Слот раздела: base — фиксированные упражнения в каждом занятии; pool — из списка кандидатов берётся pick упражнений с ротацией.",
	"type": "object",
	"additionalProperties": false,
	"required": ["id", "kind", "label"],
	"properties": {
		"id": {
			"$ref": "common.schema.json#/definitions/uuid"
		},
		"kind": {
			"type": "string",
			"enum": ["base", "pool"]
		},
		"label": {
			"$ref": "common.schema.json#/definitions/text"
		},
		"exercises": {
			"$ref": "common.schema.json#/definitions/ref_list",
			"description": "base: упражнения слота; pool: кандидаты ротации (Exercise.id)"
		},
		"pick": {
			"type": "integer",
			"minimum": 1
		},
		"allow_repeat": {
			"type": "boolean"
		},
		"sec_each": {
			"type": "integer",
			"minimum": 1
		},
		"rule": {
			"$ref": "common.schema.json#/definitions/text",
			"description": "Правило ротации словами (проверяется критиком программы)"
		}
	},
	"oneOf": [
		{
			"properties": {
				"kind": {
					"const": "base"
				},
				"exercises": {
					"minItems": 1
				}
			},
			"required": ["exercises"],
			"not": {
				"anyOf": [
					{
						"required": ["pick"]
					},
					{
						"required": ["allow_repeat"]
					},
					{
						"required": ["sec_each"]
					},
					{
						"required": ["rule"]
					}
				]
			}
		},
		{
			"properties": {
				"kind": {
					"const": "pool"
				},
				"exercises": {
					"minItems": 2
				}
			},
			"required": ["exercises", "pick", "allow_repeat"]
		}
	]
}
