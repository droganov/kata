{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "step.schema.json",
	"title": "Step",
	"description": "Шаг процедуры: задача, активные цели фазы, оракулы.",
	"type": "object",
	"additionalProperties": false,
	"required": ["id", "title", "active", "oracles"],
	"properties": {
		"id": {
			"$ref": "common.schema.json#/definitions/uuid"
		},
		"title": {
			"type": "string",
			"minLength": 3,
			"maxLength": 60,
			"description": "Задача в инфинитиве"
		},
		"active": {
			"$ref": "common.schema.json#/definitions/ref_list",
			"description": "Цели, работающие в этой фазе; подмножество Exercise.targets"
		},
		"oracles": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "oracle.schema.json"
			}
		}
	}
}
