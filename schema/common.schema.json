{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "common.schema.json",
	"title": "Common",
	"description": "Общие типы: идентификатор UUIDv7 (единственный вид id во всех сущностях), slug, текст",
	"definitions": {
		"uuid": {
			"type": "string",
			"pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
			"description": "UUID версии 7, нижний регистр"
		},
		"slug": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_]*$",
			"maxLength": 64,
			"description": "Человекочитаемый ключ, только латиница/цифры/подчёркивание; не идентификатор"
		},
		"text": {
			"type": "string",
			"minLength": 1
		},
		"ref_list": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/uuid"
			},
			"uniqueItems": true
		}
	}
}
