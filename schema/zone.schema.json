{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "zone.schema.json",
	"title": "Zone",
	"description": "Зона тела в банке (Шея, Трапеция, Бёдра…). Контуры вложены.",
	"type": "object",
	"additionalProperties": false,
	"required": ["id", "slug", "title", "contours"],
	"properties": {
		"id": {
			"$ref": "common.schema.json#/definitions/uuid"
		},
		"slug": {
			"$ref": "common.schema.json#/definitions/slug"
		},
		"title": {
			"$ref": "common.schema.json#/definitions/text"
		},
		"rule": {
			"$ref": "common.schema.json#/definitions/text"
		},
		"contours": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "contour.schema.json"
			}
		}
	}
}
