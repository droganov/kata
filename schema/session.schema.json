{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "session.schema.json",
  "title": "Session",
  "description": "Занятие: выведено из программы ротацией. Хранится только как результат сборки.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "program",
    "index",
    "title",
    "minutes",
    "sections"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/definitions/uuid"
    },
    "program": {
      "$ref": "common.schema.json#/definitions/uuid"
    },
    "index": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "$ref": "common.schema.json#/definitions/text"
    },
    "minutes": {
      "type": "integer",
      "minimum": 1
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section",
          "slots"
        ],
        "properties": {
          "section": {
            "$ref": "common.schema.json#/definitions/uuid"
          },
          "slots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "slot",
                "exercises"
              ],
              "properties": {
                "slot": {
                  "$ref": "common.schema.json#/definitions/uuid"
                },
                "exercises": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "exercise",
                      "dose"
                    ],
                    "properties": {
                      "exercise": {
                        "$ref": "common.schema.json#/definitions/uuid"
                      },
                      "dose": {
                        "$ref": "common.schema.json#/definitions/text"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
