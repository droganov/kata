{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "oracle.schema.json",
  "title": "Oracle",
  "description": "Оракул шага: D = (∀ model) ∧ ¬(∃ counterModel).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "predicate",
    "model",
    "counterModel"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/definitions/uuid"
    },
    "predicate": {
      "type": "string",
      "minLength": 3,
      "maxLength": 90,
      "description": "Ровно одно наблюдаемое утверждение"
    },
    "model": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 90
      }
    },
    "counterModel": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 90
      }
    }
  }
}
